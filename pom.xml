  <modules><module>api</module><module>control-plane</module><module>gateway</module><module>cli</module><module>demo-backend</module><module>integration-tests</module></modules>
  <properties><maven.compiler.release>21</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding><grpc.version>1.85.0</grpc.version><protobuf.version>3.25.9</protobuf.version><netty.version>4.2.19.Final</netty.version><ratis.version>3.3.1</ratis.version><junit.version>5.14.4</junit.version></properties>
  <dependencyManagement><dependencies>
